{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "observation points",
  "type": "object",
  "required": [
    "schema",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer"
    },
    "note": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "addr"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "break",
              "watch-r",
              "watch-w",
              "watch-a"
            ]
          },
          "addr": {
            "type": "string",
            "description": "guest address, 0x-prefixed"
          },
          "len": {
            "type": "integer",
            "description": "watch length in bytes"
          },
          "one_shot": {
            "type": "boolean",
            "description": "fire once, then remove the point"
          },
          "max_hits": {
            "type": "integer",
            "description": "hit throttle: stop recording after this many"
          },
          "cooldown_s": {
            "type": "number",
            "description": "hit throttle: minimum seconds between recorded hits"
          },
          "capture": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "regs | mem:0xADDR:SIZE | t0"
          }
        }
      }
    }
  }
}
