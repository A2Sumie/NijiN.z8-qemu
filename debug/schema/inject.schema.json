{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "injections",
  "type": "object",
  "required": [
    "schema",
    "injections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer"
    },
    "note": {
      "type": "string"
    },
    "injections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "poke",
              "poison",
              "key-body",
              "event",
              "module"
            ]
          },
          "at": {
            "type": "string",
            "description": "observation point id, empty for session start"
          },
          "addr": {
            "type": "string"
          },
          "bytes": {
            "type": "string",
            "description": "hex payload"
          },
          "file": {
            "type": "string",
            "description": "module feed: image path"
          },
          "channel": {
            "type": "string",
            "description": "input channel name"
          },
          "machine_property": {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {}
            }
          }
        }
      }
    }
  }
}
