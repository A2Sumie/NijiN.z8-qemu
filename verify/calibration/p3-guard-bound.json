    {
      "do": "wait_pc",
      "pc": "0x0",
      "timeout": 300,
      "note": "invalid case is offered"
    },
    {
      "do": "read_mem",
      "addr": "0x0",
      "size": 4,
      "as": "invalid_result"
    },
    {
      "do": "read_mem",
      "addr": "0x0",
      "size": 4,
      "as": "gate_silent"
    },
    {
      "do": "snapshot"
    }
