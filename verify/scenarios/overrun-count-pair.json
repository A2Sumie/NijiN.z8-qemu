{
  "schema": 1,
  "name": "overrun-count-pair",
  "note": "Template. Every address below is a placeholder. Copy to verify/local/ and fill in the values your build needs. Coordinates of a real build are not distributed.",
  "machine": "nikon-z8-lab,bootstrap-fixtures=on,serial-fixture=on,service-core-event-model=on",
  "firmware": "<path to the firmware build under test>",
  "qemu": "<path to build/qemu-system-aarch64>",
  "load_addr": "0x40160000",
  "steps": [
    { "do": "wait_pc", "pc": "0x0", "timeout": 300, "note": "first point: the walk is reachable" },
    { "do": "poison", "tag": "slot-after-table", "note": "place a live object right after the walked table" },
    { "do": "read_mem", "addr": "0x0", "size": 4, "as": "count_registration", "note": "count source 1" },
    { "do": "read_mem", "addr": "0x0", "size": 4, "as": "count_save_immediate", "note": "count source 2" },
    { "do": "invoke", "cpu": 0, "fn": "0x0", "x0": "0x0", "x1": "0x0", "note": "call the walk under test" },
    { "do": "skip_call", "pc": "0x0", "w0": "0x0", "note": "optional: force a gate result to reach the walk" },
    { "do": "cont", "seconds": 10 },
    { "do": "read_mem", "addr": "0x0", "size": 4, "as": "count_table_extent", "note": "count source 3" },
    { "do": "snapshot" }
  ],
  "poison": [
    { "tag": "slot-after-table", "addr": "0x0", "bytes": "0000000000000000", "note": "bytes must differ from what the walk would write" }
  ],
  "counts": {
    "extent": 0,
    "sources": [
      { "id": "registration", "read": "count_registration" },
      { "id": "save_immediate", "read": "count_save_immediate" },
      { "id": "table_extent", "read": "count_table_extent" }
    ]
  },
  "rejections": [
    { "id": "unmodeled-dma", "trace": "Z8_GRAPHICS_DMA_UNMODELED", "note": "declare the reject paths this scenario exercises" }
  ],
  "accepts_unmodeled": [],
  "crash": { "trace_markers": ["Z8_UNKNOWN"] }
}
